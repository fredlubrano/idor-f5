{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "idor-f5/feature_record",
  "title": "IDOR aspiration feature record",
  "type": "object",
  "required": ["features", "label"],
  "properties": {
    "user_id_hash": { "type": "string", "description": "Hashed identity (jwt_sub or ip)" },
    "auth_present": { "type": "boolean" },
    "score": { "type": "number" },
    "level": { "type": "string", "enum": ["none", "low", "medium", "high"] },
    "features": {
      "type": "object",
      "required": [
        "distinct_object_ids",
        "sequential_ratio",
        "forbid_ratio",
        "ok_ratio",
        "req_count",
        "response_bytes_sum",
        "template_focus",
        "aspiration_score"
      ],
      "properties": {
        "distinct_object_ids": { "type": "integer", "minimum": 0 },
        "sequential_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "forbid_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "ok_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "req_count": { "type": "integer", "minimum": 0 },
        "response_bytes_sum": { "type": "integer", "minimum": 0 },
        "template_focus": { "type": "number", "minimum": 0, "maximum": 1 },
        "aspiration_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "path_template": { "type": "string" },
        "status_seq": { "type": "string" },
        "ids_per_minute": { "type": "number", "minimum": 0 }
      }
    },
    "label": {
      "type": "string",
      "enum": ["normal", "legitim_sync", "sequential_enum", "data_aspiration"]
    },
    "label_id": { "type": "integer", "minimum": 0, "maximum": 3 },
    "source": { "type": "string", "description": "lab_script | shadow_export | synthetic" }
  }
}

# Copy to .env (never commit). Used by deploy scripts / local LX testing.
GEMINI_API_KEY=
GOOGLE_API_KEY=
MU_AI_KEY_FILE=/config/gemini_api_key
MU_AI_MODEL=gemini-2.5-flash
MU_AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
MU_AI_TIMEOUT_MS=800
MU_AI_HASH_IDS=true
BIGIP_HOST=https://bigip.lab
BIGIP_USER=admin
BIGIP_PASSWORD=
